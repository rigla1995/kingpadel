# =============================================================
# KingPadel — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# =============================================================

# ----- Base de données -----
DATABASE_URL="postgresql://kingpadel:kingpadel@localhost:5432/kingpadel_dev"
REDIS_URL="redis://localhost:6379"

# ----- API Backend (NestJS) -----
API_PORT=3001
NODE_ENV=development

# ----- JWT Auth -----
JWT_SECRET=change_this_secret_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ----- OAuth2 (optionnel en local) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ----- Paiement -----
# Stripe (international)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Konnect (Tunisie)
KONNECT_API_KEY=
KONNECT_API_URL=https://api.preprod.konnect.network

# ----- Notifications Push -----
EXPO_ACCESS_TOKEN=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# ----- Email -----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kingpadel.tn

# ----- App URLs -----
WEB_ENSEIGNE_URL=http://localhost:3002
WEB_ADMIN_URL=http://localhost:3003
MOBILE_API_URL=http://localhost:3001

# ----- NextAuth (web apps) -----
NEXTAUTH_SECRET=change_this_nextauth_secret
NEXTAUTH_URL=http://localhost:3002
