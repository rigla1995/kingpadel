{
  "name": "kingpadel",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@kingpadel/api --filter=@kingpadel/web-enseigne --filter=@kingpadel/web-admin",
    "dev:api": "pnpm --filter @kingpadel/api dev",
    "dev:mobile": "pnpm --filter @kingpadel/mobile dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
